{
  "name": "PillarDiagnosticEntry",
  "type": "object",
  "properties": {
    "diagnosis_date": {
      "type": "string",
      "format": "date",
      "description": "Date de l'\u00e9valuation"
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12,
      "description": "Mois du diagnostic"
    },
    "year": {
      "type": "integer",
      "description": "Ann\u00e9e du diagnostic"
    },
    "spiritual_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "financial_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "emotional_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "physical_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "time_management_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "relational_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "identity_vocation_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "blocking_notes": {
      "type": "string",
      "description": "Notes sur les points de blocage identifi\u00e9s"
    },
    "summary_notes": {
      "type": "string",
      "description": "Notes et r\u00e9flexions g\u00e9n\u00e9rales"
    },
    "priority_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Piliers prioritaires pour le mois \u00e0 venir"
    },
    "corrective_actions": {
      "type": "string",
      "description": "Actions correctives g\u00e9n\u00e9r\u00e9es par IA (JSON stringifi\u00e9)"
    }
  },
  "required": [
    "diagnosis_date",
    "month",
    "year"
  ]
}